      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "description": "Captures sent to an unknown or expired bin during the selected dashboard range."
    },
    {
      "id": 6,
      "title": "Application 5xx",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hooklook-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(hooklook_http_requests_total{status=~\"5..\",status!=\"507\"}[$__range])) or vector(0)",
          "refId": "A",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#74BE69",
                "value": null
              },
              {
                "color": "#DE736A",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "description": "Application HTTP 5xx responses during the selected range. Capacity 507 responses are excluded."
    },
    {
      "id": 1,
      "title": "Service up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hooklook-prometheus"
      },
      "targets": [
        {
          "expr": "min(up{job=\"hooklook\"})",
          "refId": "A",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#DE736A",
                "value": null
              },
              {
                "color": "#74BE69",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#DE736A"
                },
                "1": {
                  "text": "UP",
                  "color": "#74BE69"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Prometheus-generated scrape status for job hooklook: 1 means the latest scrape of hooklook:9092 succeeded; 0 means it failed. This is not the /health endpoint."
    },
    {
