{
  "uid": "hooklook-operator",
  "title": "Hooklook operator",
  "schemaVersion": 39,
  "version": 5,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "hooklook"
  ],
  "panels": [
    {
      "id": 100,
      "title": "Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "title": "Requests",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hooklook-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(hooklook_http_requests_total[$__range])) or vector(0)",
          "refId": "A",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F9BA8"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "description": "Completed application requests in the selected dashboard range. Responses generated at Caddy, such as public 413, 429, and 431, are excluded."
    },
    {
      "id": 4,
      "title": "Accepted captures",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hooklook-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(hooklook_capture_results_total{result=\"accepted\"}[$__range])) or vector(0)",
          "refId": "A",
          "legendFormat": "captures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#74BE69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "description": "Captures persisted successfully during the selected dashboard range."
    },
    {
      "id": 5,
