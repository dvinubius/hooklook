# Shell convenience only; the application reads process environment variables.
#
# Development: the browser sits on the Vite origin, which proxies to Go.
PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_DEV=1
LISTEN_ADDRESS=127.0.0.1:8080
ADMIN_TOKEN=local-operator-secret
# Maximum SQLite main-database file size in decimal bytes (default 5000000000).
# MAX_STORE=5000000000

# Production: the public origin Caddy terminates, and no FRONTEND_DEV.
# PUBLIC_BASE_URL=https://hooklook.app
# LISTEN_ADDRESS=0.0.0.0:8080
# ADMIN_TOKEN=<operator secret>

# Production values live only in the VPS-owned /opt/hooklook/.env and
# .env.observability; GitHub Actions deploys and never sees them. The VPS also
# keeps .env.image (HOOKLOOK_IMAGE=ghcr.io/<owner>/hooklook@sha256:...).
# Private observability profile. Use unique production credentials; never
# commit them.
# GRAFANA_ADMIN_USER=hooklook-operator
# GRAFANA_ADMIN_PASSWORD=<long URL-safe secret>
# METRICS_LISTEN_ADDRESS=127.0.0.1:9092 (local default)
