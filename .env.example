# Shell convenience only; the application reads process environment variables.
#
# Development: the browser sits on the Vite origin, which proxies to Go.
PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_DEV=1
ADMIN_TOKEN=local-operator-secret
# Maximum SQLite main-database file size in decimal bytes (default 5000000000).
# MAX_STORE=5000000000

# Production: the public origin Caddy terminates, and no FRONTEND_DEV.
# PUBLIC_BASE_URL=https://hooklook.dinubarbu.com
# ADMIN_TOKEN=<operator secret>
